# Copy to .env (scripts/n8n_setup.sh does this for you and generates a token).
# n8n webhook that receives Munjiz events. Leave empty to run without n8n.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/munjiz-events
# How n8n (inside Docker) reaches the Munjiz API on this machine.
MUNJIZ_PUBLIC_API_URL=http://host.docker.internal:8000
# Shared secret n8n sends back in the X-Munjiz-Token header.
MUNJIZ_API_TOKEN=change-me
# Agent backend: local (offline parser) or claude (needs ANTHROPIC_API_KEY).
MUNJIZ_BACKEND=local
